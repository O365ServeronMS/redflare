{
  "name": "redflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node scripts/rf-test.mjs all",
    "preview": "vite preview",
    "start": "wrangler dev --remote",
    "cf-typegen": "wrangler types --strict-vars=false",
    "worker:typecheck": "npm run cf-typegen && tsc --project tsconfig.worker.json --noEmit",
    "test:hero-snapshot": "node --test tests/heroSnapshotRepository.test.mjs",
    "test:hero-refresh": "node scripts/run-bundled-test.mjs tests/heroSnapshotRefresh.test.mjs",
    "test:hero-home-data": "node scripts/run-bundled-test.mjs tests/heroHomeData.test.mjs",
    "test:home-rail-ordering": "node scripts/run-bundled-test.mjs tests/homeRailOrdering.test.mjs",
    "test:recommendation-safety": "node scripts/run-bundled-test.mjs tests/recommendationFailureSafety.test.mjs",
    "test:recommendation-refresh": "node scripts/run-bundled-test.mjs tests/recommendationRefresh.test.mjs",
    "test:recommendation-client": "node --test tests/recommendationClient.test.mjs",
    "test:incremental-sync": "node scripts/run-bundled-test.mjs tests/incrementalSyncSafety.test.mjs",
    "test:season-poster": "node scripts/run-bundled-test.mjs tests/seasonPoster.test.mjs",
    "test:image-policy": "node --test tests/imagePolicy.test.mjs",
    "test:catalog-stats": "node scripts/run-bundled-test.mjs tests/catalogStats.test.mjs",
    "test:cron-dispatch": "node scripts/run-bundled-test.mjs tests/cronDispatch.test.mjs",
    "test:health-sync": "node scripts/run-bundled-test.mjs tests/healthSync.test.mjs",
    "test:search": "node scripts/run-bundled-test.mjs tests/search.test.mjs",
    "db:migrate": "wrangler d1 migrations apply redflare-db --remote"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.3",
    "hono": "^4.13.13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
